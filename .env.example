LE_ACCOUNT_EMAIL=me@example.com
SERVER_FQDN=example.com
HOST_USERNAME=ubuntu

# Versions
TRAEFIK_VERSION=v3.7.13
TRAEFIK_WHOAMI_VERSION=v1.12.0
OAUTH2_PROXY_VERSION=v7.4.0
CURL_VERSION=8.11.1
CHROMIUM_VERSION=7b8e918f-ls63

# Browser (/browser). PUID/PGID: your host user's `id -u` / `id -g`.
BROWSER_DATA_DIR=./data/browser
BROWSER_PUID=1000
BROWSER_PGID=1000

# CloudCLI (standalone, runs on host via start.sh)
CLOUDCLI_DATA_DIR=./data/cloudcli
CLOUDCLI_INIT_USERNAME=changeme
CLOUDCLI_INIT_PASSWORD=changeme123
